function normalizeJudgeAssignments(input, legacyLombas=[]){
  const map=new Map();
  const add=(lomba,levels)=>{if(!L[lomba]) return; const lv=normalizeLevelKeys(levels,true); if(!lv.length) return; const prev=map.get(lomba)||new Set(); lv.forEach(x=>prev.add(x)); map.set(lomba,prev);};
  if(Array.isArray(input)){
    for(const x of input){
      if(typeof x==='string'){add(x,LEVEL_KEYS);continue;}
      add(String(x?.lomba||''),x?.tingkat||x?.levels||x?.tingkats);
    }
  }else if(input && typeof input==='object'){
    for(const [k,v] of Object.entries(input)) add(k,v);
  }
  if(!map.size && Array.isArray(legacyLombas)) legacyLombas.forEach(k=>add(String(k),LEVEL_KEYS));
  return [...map.entries()].map(([lomba,levels])=>({lomba,tingkat:[...levels]}));
}
