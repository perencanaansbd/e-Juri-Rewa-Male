function validateCriteria(aspects){
  if(!Array.isArray(aspects) || !aspects.length) throw new Error('Minimal harus ada 1 kriteria penilaian.');
  let total=0;
  const clean=aspects.map((x,i)=>{
    const name=String(x?.name??x?.[0]??'').trim();
    const points=Number(x?.points??x?.[1]);
    if(name.length<2 || name.length>120) throw new Error(`Nama kriteria ke-${i+1} harus 2-120 karakter.`);
    if(!Number.isFinite(points) || points<=0 || points>100) throw new Error(`Poin kriteria ke-${i+1} harus lebih dari 0 dan maksimal 100.`);
    total+=points;
    return {name,points};
  });
  total=Math.round(total*100)/100;
  if(total!==100) throw new Error(`Total poin seluruh kriteria harus tepat 100. Saat ini ${total}.`);
  return clean;
}

