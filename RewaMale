async function sendXlsx(res, filename, title, columns, rows){
  const wb=new ExcelJS.Workbook(); wb.creator='E-Juri Rewa Male'; wb.created=new Date();
  const ws=wb.addWorksheet(title.slice(0,31)||'Data');
  ws.addRow([title]); ws.mergeCells(1,1,1,columns.length); ws.getRow(1).font={bold:true,size:14};
  ws.addRow(columns.map(c=>c.header)); ws.getRow(2).font={bold:true}; ws.freezePanes={row:3};
  for(const row of rows) ws.addRow(columns.map(c=>row[c.key]??''));
  ws.autoFilter={from: {row:2,column:1}, to:{row:Math.max(2,ws.rowCount),column:columns.length}};
  columns.forEach((c,i)=>{ws.getColumn(i+1).width=Math.min(42,Math.max(12,c.header.length+2, ...rows.slice(0,50).map(r=>String(r[c.key]??'').length+2)));});
  ws.eachRow((r,idx)=>{ if(idx>=3) r.alignment={vertical:'top',wrapText:true}; });
  res.setHeader('Content-Type','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
  res.setHeader('Content-Disposition',`attachment; filename="${filename}"`);
  await wb.xlsx.write(res); res.end();
}
function sendPdf(res, filename, title, columns, rows){
  const doc=new PDFDocument({size:'A4',margin:28,layout:'landscape'});
  res.setHeader('Content-Type','application/pdf'); res.setHeader('Content-Disposition',`attachment; filename="${filename}"`); doc.pipe(res);
  doc.fontSize(15).font('Helvetica-Bold').text(title,{align:'center'}); doc.moveDown(0.35); doc.fontSize(8).font('Helvetica');
  const widths=columns.map(c=>Math.max(55, Math.min(150, c.width||80))); const total=widths.reduce((a,b)=>a+b,0); const scale=(doc.page.width-doc.page.margins.left-doc.page.margins.right)/total; const ws=widths.map(w=>w*scale);
  let y=doc.y, x=doc.page.margins.left, rowH=22;
  const drawRow=(vals,header=false)=>{x=doc.page.margins.left; let maxLines=1; vals.forEach((v,i)=>{const text=String(v??'');const w=ws[i];const h=header?28:rowH;doc.rect(x,y,w,h).stroke();doc.font(header?'Helvetica-Bold':'Helvetica').fontSize(header?7.5:7).text(text,x+3,y+4,{width:w-6,height:h-7,ellipsis:true});x+=w;});return header?28:rowH};
  let headerVals=columns.map(c=>c.header); y+=2; y+=drawRow(headerVals,true)+4;
  for(const row of rows){ if(y+rowH>doc.page.height-doc.page.margins.bottom-15){doc.addPage({size:'A4',layout:'landscape',margin:28});y=doc.page.margins.top;drawRow(headerVals,true);y+=32;} drawRow(columns.map(c=>row[c.key]??''));y+=rowH; }
  if(!rows.length) doc.fontSize(10).text('Tidak ada data.'); doc.end();
}
