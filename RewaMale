app.post('/api/restore',requireAdmin,express.raw({type:'application/octet-stream',limit:'50mb'}),(req,res)=>{
  const tmp=path.join(DATA_DIR,`restore-${Date.now()}.sqlite`);
  try{
    if(!req.body || !Buffer.isBuffer(req.body) || !req.body.length) return res.status(400).json({error:'File backup kosong'});
    fs.writeFileSync(tmp,req.body);
    const escaped=tmp.replace(/'/g,"''");
    db.exec(`ATTACH DATABASE '${escaped}' AS restoredb`);
    const check=db.prepare('PRAGMA restoredb.integrity_check').get();
    if(!check || !String(Object.values(check)[0]).toLowerCase().includes('ok')) throw new Error('Database backup tidak valid');
    const tables=['settings','users','participants','scores','audit_logs','environments','jury_assignments','competitions','competition_criteria'];
    const getCols=(schema,t)=>db.prepare(`PRAGMA ${schema}.table_info(${t})`).all().map(x=>x.name);
    const commonCols=(t)=>{
      const src=getCols('restoredb',t);
      const dst=getCols('main',t);
      return dst.filter(c=>src.includes(c));
    };
    const tx=db.transaction(()=>{
      db.exec('PRAGMA foreign_keys=OFF');
      for(const t of tables){
        const cols=commonCols(t);
        if(!cols.length) continue;
        db.exec(`DELETE FROM main.${t}`);
        const q=cols.map(c=>'\"'+c.replace(/\"/g,'\"\"')+'\"').join(',');
        db.exec(`INSERT INTO main.${t} (${q}) SELECT ${q} FROM restoredb.${t}`);
      }
      db.exec('PRAGMA foreign_keys=ON');
    });
    tx();
    // Pastikan schema baru tetap terisi setelah restore backup lama.
    const restoredSetting=db.prepare('SELECT id FROM settings WHERE id=1').get();
    if(!restoredSetting) db.prepare('INSERT OR IGNORE INTO settings(id) VALUES(1)').run();
    const settingCols2=db.prepare('PRAGMA table_info(settings)').all().map(x=>x.name);
    if(settingCols2.includes('stasi_paroki')){
      const sp=db.prepare('SELECT stasi_paroki FROM settings WHERE id=1').get();
      if(sp && !sp.stasi_paroki){
        const old=db.prepare('SELECT lingkungan_kub FROM settings WHERE id=1').get();
        if(old?.lingkungan_kub) db.prepare('UPDATE settings SET stasi_paroki=? WHERE id=1').run(old.lingkungan_kub);
      }
    }
    db.exec('DETACH DATABASE restoredb');
    fs.rmSync(tmp,{force:true});
    ensureDefaultCompetitions();
    loadLombaConfig();
    seedEnvironmentsFromParticipants();
    seedJuryAssignments();
    audit(req,'RESTORE','all','1','Restore database dari backup');
    emitData();
    res.json({ok:true});
  }catch(e){
    try{db.exec('DETACH DATABASE restoredb')}catch{}
    fs.rmSync(tmp,{force:true});
    res.status(400).json({error:`Restore gagal: ${e.message}`});
  }
});
