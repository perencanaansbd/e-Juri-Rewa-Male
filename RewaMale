        for(const lv of LEVEL_KEYS){add.run(u.id,k,lv);occupied.add(`${Number(u.judge_no)}:${k}:${lv}`);}
      }
    }
    // Akun generik juri1/juri2/juri3 tetap kompatibel pada instalasi lama/fresh install.
    // Akun yang sudah mempunyai penugasan eksplisit tidak diubah.
    for(const u of rows.filter(x=>!hasAssignments.has(Number(x.id)) && /^juri[1-3]$/i.test(String(x.username||'')))){
      const no=Number(u.judge_no); if(![1,2,3].includes(no)) continue;
      for(const k of Object.keys(L)) for(const lv of LEVEL_KEYS){
        const seat=`${no}:${k}:${lv}`;
        if(!occupied.has(seat)){add.run(u.id,k,lv);occupied.add(seat);}
      }
    }
  });
  tx();
}
function getAssignedLombaKeys(userId){
