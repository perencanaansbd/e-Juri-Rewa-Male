}
function normalizeLombaKeys(input){
  const raw=Array.isArray(input)?input:(input==null?[]:[input]);
  return [...new Set(raw.map(x=>String(x||'').trim()).filter(k=>L[k]))];
}
function judgeAssignmentConflict(judgeNo,assignments,excludeUserId=null){
  const q=db.prepare(`SELECT u.id,u.nama,ja.lomba,ja.tingkat FROM jury_assignments ja JOIN users u ON u.id=ja.user_id\n    WHERE ja.lomba=? AND ja.tingkat=? AND u.role='juri' AND u.judge_no=? AND u.active=1 AND u.id<>? LIMIT 1`);
  for(const a of assignments){for(const lv of a.tingkat){const hit=q.get(a.lomba,lv,Number(judgeNo),Number(excludeUserId||0));if(hit)return hit;}}
  return null;
}
