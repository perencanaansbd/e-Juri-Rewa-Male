function getParticipants(filters={}){
  let sql = 'SELECT * FROM participants WHERE 1=1'; const p=[];
  if(filters.lomba){sql+=' AND lomba=?';p.push(filters.lomba)}
  if(filters.tingkat){sql+=' AND tingkat=?';p.push(filters.tingkat)}
  if(filters.q){sql+=' AND (lower(nomor_peserta) LIKE lower(?) OR lower(nama_peserta) LIKE lower(?) OR lower(lingkungan_kub) LIKE lower(?))'; const q=`%${filters.q}%`;p.push(q,q,q)}
  sql += ' ORDER BY tingkat, COALESCE(urut_tampil,999999), nomor_peserta';
  return db.prepare(sql).all(...p);
}
function getScoresMap(){
  const rows=db.prepare('SELECT * FROM scores').all();
  const m=new Map();
  for(const r of rows){let key=`${r.participant_id}:${r.jury_id}`;m.set(key,{id:r.id,values:JSON.parse(r.values_json),total:r.total,note:r.note,saved_at:r.saved_at,updated_at:r.updated_at});}
  return m;
}
function results(lomba,tingkat='TEMU_MINGGU'){
  const lv=LEVEL_NAME[tingkat]?tingkat:'TEMU_MINGGU';
  const ps=db.prepare('SELECT * FROM participants WHERE lomba=? AND tingkat=? ORDER BY nomor_peserta').all(lomba,lv);
  const j=assignedJuriesFor(lomba,lv);
  const sm=getScoresMap();
  return ps.map(p=>{
    const vals=j.map(x=>{
      const s=sm.get(`${p.id}:${x.id}`) || (lv==='TEMU_MINGGU' ? sm.get(`${p.id}:${legacyJuryIdFor(lomba,x.judge_no)}`) : null);
      return s?.total ?? null;
    });
    const submitted=vals.filter(v=>v!==null).length;
    const complete=j.length>0 && submitted===j.length;
    const submittedTotal=vals.filter(v=>v!==null).reduce((a,b)=>a+b,0);
    const total=complete?submittedTotal:null;
    const averageSubmitted=submitted?submittedTotal/submitted:null;
    return {...p,juries:j.map((x,i)=>({id:x.id,name:x.name,judge_no:x.judge_no,user_id:x.user_id,username:x.username,nama:x.nama,total:vals[i]})),submitted,complete,total,average:total===null?null:total/j.length,averageSubmitted};
  }).sort((a,b)=>(b.averageSubmitted??-1)-(a.averageSubmitted??-1));
}
function assignedJuriesFor(lomba,tingkat='TEMU_MINGGU'){
  const lv=LEVEL_NAME[tingkat]?tingkat:'TEMU_MINGGU';
  const users=db.prepare(`SELECT u.id,u.username,u.nama,u.judge_no,u.jury_id,u.active,ja.tingkat\n    FROM jury_assignments ja JOIN users u ON u.id=ja.user_id\n    WHERE ja.lomba=? AND ja.tingkat IN (?, 'ALL') AND u.role='juri' AND u.active=1\n    ORDER BY u.judge_no ASC,u.id ASC`).all(lomba,lv);
  return users.map(u=>({id:juryIdFor(lomba,Number(u.judge_no),lv),name:`Juri ${Number(u.judge_no)}`,judge_no:Number(u.judge_no),user_id:u.id,username:u.username,nama:u.nama,active:Number(u.active),tingkat:lv}));
}
function summary(){
  const participants=db.prepare('SELECT * FROM participants').all();
  const scoreRows=db.prepare('SELECT * FROM scores').all();
  let complete=0;
  const byParticipant = new Map();
  for(const s of scoreRows){ if(!byParticipant.has(s.participant_id)) byParticipant.set(s.participant_id,new Map()); byParticipant.get(s.participant_id).set(s.jury_id,s); }
  for(const p of participants){ const need=assignedJuriesFor(p.lomba,p.tingkat).length; const got=byParticipant.get(p.id)?.size||0; if(need>0 && got>=need) complete++; }
  return {participants:participants.length, scoreEntries:scoreRows.length, completed:complete, completionPercent:participants.length?Math.round(complete/participants.length*100):0};
}


