function resultRowsFor(lomba,tingkat='TEMU_MINGGU'){
  if(!L[lomba]) return [];
  const lv=LEVEL_NAME[tingkat]?tingkat:'TEMU_MINGGU'; const rows=results(lomba,lv); let rank=0;
  const orderedJuries=assignedJuriesFor(lomba,lv);
  return rows.map((x)=>{
    const hasScore=x.averageSubmitted!==null; if(hasScore) rank++;
    const row={rank:hasScore?rank:'',nomor_peserta:x.nomor_peserta,nama_peserta:x.nama_peserta,lingkungan_kub:x.lingkungan_kub||'',submitted:x.submitted,juryCount:x.juries.length,average:x.averageSubmitted===null?'':Number(x.averageSubmitted),status:x.complete?'FINAL':`${x.submitted}/${x.juries.length} JURI`};
    orderedJuries.forEach((j,i)=>{row[`j${j.judge_no}`]=x.juries[i]?.total??'';});
    return row;
  });
}
